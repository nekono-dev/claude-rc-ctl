#!/usr/bin/env bash
# claude-rc@.service から tmux 内で呼ばれる起動ラッパー
# 使い方: claude-rc-run <name>
set -u
name="$1"
conf="$HOME/.config/claude-rc/$name.env"
# shellcheck source=/dev/null
. "$conf"

# nvm を読み込んで claude を PATH に通す（Node のバージョン変更に追従させるため）
export NVM_DIR="$HOME/.nvm"
# shellcheck source=/dev/null
. "$NVM_DIR/nvm.sh" >/dev/null 2>&1

cd "$CLAUDE_RC_DIR" || { echo "ディレクトリがありません: $CLAUDE_RC_DIR" >&2; sleep 30; exit 1; }

# effort は remote-control のオプションにないため、環境変数で各セッションへ継承させる
effort="${CLAUDE_RC_EFFORT:-medium}"
case "$effort" in
  low|medium|high|xhigh|max) ;;
  *) echo "CLAUDE_RC_EFFORT は low|medium|high|xhigh|max で指定してください: $effort" >&2; sleep 30; exit 1 ;;
esac
export CLAUDE_CODE_EFFORT_LEVEL="$effort"

# claude 本体の実行ファイルを版ごとに固定する（標準出力へ固定した複製のパスを出す）
# サーバーは自分の実行ファイルのパスから子セッションを起動するため、固定した複製から起動すれば、
# 本体が更新されても、サーバーと配下のセッションは同じ版で動き続ける（入れ替えの途中に実行ファイルがない状態にもならない）
VER_DIR="$HOME/.local/share/claude-rc/versions"
pin_claude() {
  local src="$1" real rel tmp ver dest
  real="$(readlink -f "$src")" || return 1
  # claude は置き場所で導入方式を判定し、自動更新の方法を変える。npm の導入は node_modules からの相対配置を保ち、npm 版として扱わせる
  case "$real" in
    */node_modules/*) rel="node_modules/${real##*/node_modules/}" ;;
    *) rel="claude" ;;
  esac
  tmp="$VER_DIR/.tmp-$$"
  rm -rf "$tmp"
  mkdir -p "$tmp/$(dirname "$rel")" || return 1
  # 同じファイルシステムならハードリンク（容量を使わず、元が入れ替わっても旧版の内容を保つ）
  ln "$real" "$tmp/$rel" 2>/dev/null || cp -p "$real" "$tmp/$rel" || { rm -rf "$tmp"; return 1; }
  ver="$("$tmp/$rel" --version 2>/dev/null | awk 'NR==1{print $1}')"
  [[ "$ver" =~ ^[0-9A-Za-z._+-]+$ ]] || { rm -rf "$tmp"; return 1; }
  dest="$VER_DIR/$ver"
  # 同じ版が既にあれば既存を使う（-T は既存のディレクトリの中へ移さず失敗させる。同時起動でも上書きしない）
  mv -T "$tmp" "$dest" 2>/dev/null || rm -rf "$tmp"
  [ -x "$dest/$rel" ] || return 1
  # 元の場所（本体の更新の検出用）と、使用中の印（作られたばかりの版を削除させない）
  echo "$src" > "$dest/source" || return 1
  touch "$dest"
  echo "$dest/$rel"
}

src="$(command -v claude)" || { echo "claude が見つかりません（nvm で導入してください）" >&2; sleep 30; exit 1; }
claude="$(pin_claude "$src")" || { echo "警告: claude の実行ファイルを版ごとに固定できないため、そのまま起動します: $src" >&2; claude="$src"; }

# セッションを事前に作らない（作ると再開用の記録が残り、停止してもアーカイブされない）
args=(remote-control
  --no-create-session-in-dir
  --spawn "${CLAUDE_RC_SPAWN:-same-dir}"
  --permission-mode "${CLAUDE_RC_PERMISSION_MODE:-auto}"
  --remote-control-session-name-prefix "$(hostname)-$name")

# --continue は --spawn と併用できないため、再起動時は常に新規に立ち上げる
exec "$claude" "${args[@]}"
