#!/usr/bin/env bash
# claude remote-control 常駐サービスの管理コマンド
set -euo pipefail

CONF_DIR="$HOME/.config/claude-rc"
# 判定の記録（警告済みの起動失敗の件数）を置く場所
STATE_DIR="$HOME/.local/state/claude-rc"
# 起動ラッパーが claude の実行ファイルを版ごとに固定する置き場所
VER_DIR="$HOME/.local/share/claude-rc/versions"
unit() { echo "claude-rc@$1.service"; }

usage() {
  cat <<USAGE
使い方: claude-rc-ctl <コマンド> [引数]

  add [--spawn <same-dir|worktree>] <dir> [name]
                     ディレクトリを登録して起動（name 省略時はディレクトリ名、
                     --spawn 省略時は same-dir）
  remove <name>      停止して登録解除
  list               登録済みの一覧と状態
  start|stop|restart|status <name>
  archive [--dry-run] <name|--all>
                     全セッションがアイドルでリマインダーもなければ、サーバーを再起動して
                     セッションをアーカイブ（--dry-run は判定の表示のみ）
  attach <name>      tmux 画面に接続（抜けるときは Ctrl-b d）
  logs <name>        画面の直近出力とジャーナルを表示
  self update [--ref NAME] [--set KEY=VALUE ...]
                                      導入中のブランチ・タグの最新へ更新（--ref で切り替え）
  self refs                           切り替えられるブランチとタグを表示
  self uninstall [--purge]            本体を削除（--purge で登録・設定も削除）
  self status                         導入情報を表示

設定ファイル: $CONF_DIR/<name>.env
  CLAUDE_RC_DIR              対象ディレクトリ（必須）
  CLAUDE_RC_SPAWN            spawn モード（既定: same-dir）
  CLAUDE_RC_PERMISSION_MODE  権限モード（既定: auto）
  CLAUDE_RC_EFFORT           effort（low|medium|high|xhigh|max、既定: medium）
  CLAUDE_RC_ARCHIVE_MINUTES  アーカイブまでのアイドル時間・分（既定: 10080、0 でアーカイブしない）
  CLAUDE_RC_STALE_MINUTES    claude 本体の更新後、新しい版で再起動するまでに待つアイドル時間・分（既定: 10080、0 で再起動しない）

固定した claude の版: $VER_DIR/<版>/
USAGE
}

need_name() { [ $# -ge 1 ] || { usage; exit 1; }; [ -f "$CONF_DIR/$1.env" ] || { echo "未登録です: $1" >&2; exit 1; }; }

is_trusted() {
  python3 - "$1" <<'PY'
import json, os, sys
try:
    d = json.load(open(os.path.expanduser("~/.claude.json")))
    sys.exit(0 if d.get("projects", {}).get(sys.argv[1], {}).get("hasTrustDialogAccepted") else 1)
except Exception:
    sys.exit(1)
PY
}

# report_failures <name> <pid> <dry(0|1)>: サーバーの画面出力から、セッションの起動失敗の記録を探して警告する
# claude 本体の更新の途中など、実行ファイルがない間に作られたセッションは起動に失敗し、応答しないまま残る
# 同じ記録を繰り返し警告しないよう、警告済みの件数をサーバーのプロセスごとに記録する
report_failures() {
  local n="$1" pid="$2" dry="$3" lines count seen=0 oldpid="" old="" f="$STATE_DIR/$1.failed"
  lines="$(tmux -L "claude-rc-$n" capture-pane -p -J -S - -t "$n" 2>/dev/null | grep -E '^\[[0-9]{2}:[0-9]{2}:[0-9]{2}\] Session failed:' || true)"
  count=0
  [ -z "$lines" ] || count="$(printf '%s\n' "$lines" | wc -l)"
  if [ -f "$f" ]; then
    read -r oldpid old < "$f" || true
    if [ "$oldpid" = "$pid" ] && [[ "$old" =~ ^[0-9]+$ ]]; then seen="$old"; fi
  fi
  [ "$count" -ne "$seen" ] || return 0
  if [ "$count" -gt "$seen" ]; then
    echo "[$n] 警告: セッションの起動に失敗した記録が $((count - seen)) 件ある（最新: $(printf '%s\n' "$lines" | tail -n 1)）" >&2
    echo "[$n] 対処: 応答しないセッションにはメッセージを送り直す。繰り返すときは claude-rc-ctl restart $n を実行する" >&2
  fi
  [ "$dry" = 1 ] || { mkdir -p "$STATE_DIR"; echo "$pid $count" > "$f"; }
}

# report_auth_failures <name> <pid> <dry(0|1)>: セッションの記録から、認証失敗で止まったセッションを探して警告する
# 通信の一時的な遮断（Cloudflare の 403 など）でも claude は「認証失敗」として扱い、アプリに再サインインを求める状態で止まる
# 資格情報そのものは有効なことが多いため、サーバーは再起動せず、警告だけを行う
# 記録の最後が認証失敗のセッションだけを対象とする（その後に応答があれば回復済み）。警告済みのセッションの記録は state に残す
report_auth_failures() {
  local n="$1" pid="$2" dry="$3" dir f="$STATE_DIR/$1.authfail" out
  # shellcheck source=/dev/null
  dir="$(. "$CONF_DIR/$n.env"; echo "${CLAUDE_RC_DIR:-}")"
  [ -n "$dir" ] || return 0
  out="$(python3 - "$pid" "$dir" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$f" "$dry" <<'PY' || true
import json, os, re, sys

pid, cdir, conf, state, dry = int(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
# サーバーの起動時刻（これより前の記録は、再起動で別のサーバーのものになっている）
clk = os.sysconf("SC_CLK_TCK")
try:
    btime = next(int(l.split()[1]) for l in open("/proc/stat") if l.startswith("btime"))
    started = btime + int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[19]) / clk
except (OSError, ValueError, StopIteration, IndexError):
    sys.exit(0)

# worktree で起動したセッションの作業先は、対象ディレクトリの配下になる（記録の置き場所の名前は、記号をすべて - にしたもの）
enc = re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(cdir))
root = os.path.join(conf, "projects")
try:
    dirs = [d for d in os.listdir(root) if d == enc or d.startswith(enc + "-")]
except OSError:
    sys.exit(0)

found = {}
for d in dirs:
    base = os.path.join(root, d)
    try:
        names = os.listdir(base)
    except OSError:
        continue
    for fn in names:
        if not fn.endswith(".jsonl"):
            continue
        path = os.path.join(base, fn)
        try:
            if os.stat(path).st_mtime < started:
                continue
            with open(path, "rb") as fh:
                fh.seek(0, 2)
                size = fh.tell()
                fh.seek(max(0, size - 1048576))
                lines = [x for x in fh.read().split(b"\n") if x.strip()]
            rec = json.loads(lines[-1])
        except (OSError, ValueError, IndexError):
            continue
        # 末尾の attachment 等は記録の種類で読み飛ばさず、最後の記録が認証失敗かどうかだけを見る
        msg = rec.get("message") if isinstance(rec, dict) else None
        if not isinstance(msg, dict) or rec.get("type") != "assistant" or not rec.get("isApiErrorMessage"):
            continue
        text = "".join(c.get("text", "") for c in msg.get("content", []) if isinstance(c, dict))
        if text.startswith("Failed to authenticate"):
            found[rec.get("uuid") or fn] = (rec.get("timestamp") or "", fn[:-6], text.strip())

try:
    seen = set(open(state).read().split())
except OSError:
    seen = set()
for key, (ts, sid, text) in sorted(found.items(), key=lambda kv: kv[1][0]):
    if key not in seen:
        print(f"{ts} {sid} {text}")
if dry != "1":
    os.makedirs(os.path.dirname(state), exist_ok=True)
    # 回復したセッションの分は捨てる（同じ失敗が再び起きれば、新しい記録として警告される）
    open(state, "w").write("".join(k + "\n" for k in found))
PY
)"
  [ -z "$out" ] || {
    echo "[$n] 警告: 認証に失敗して止まったセッションの記録が $(printf '%s\n' "$out" | wc -l) 件ある（最新: $(printf '%s\n' "$out" | tail -n 1)）" >&2
    echo "[$n] 対処: 通信の一時的な遮断でも起きる。そのセッションにメッセージを送り直す。繰り返すときは claude auth status で資格情報を確認する" >&2
  }
}

# archive_one <name> <dry(0|1)>: 配下の全セッションがアイドルでリマインダーもなければ、サーバーを再起動する
# 再起動で remote-control が環境を登録解除し、動作中のセッションがアプリ上でアーカイブされる
# claude 本体が更新され、サーバーの固定した版が古くなったときは、猶予時間（既定はアーカイブと同じ1週間）で再起動して新しい版へ切り替える
# （再起動するとセッションがアーカイブされるので、猶予時間を短くすると、本体の更新のたびにセッションが早くアーカイブされる）
# 固定した実行ファイルが削除されたときは、新しいセッションを起動できないため、実行中のセッションがなければすぐに再起動する
archive_one() {
  local n="$1" dry="$2" idle stale pid rc=0
  # shellcheck source=/dev/null
  idle="$(. "$CONF_DIR/$n.env"; echo "${CLAUDE_RC_ARCHIVE_MINUTES:-10080}")"
  [[ "$idle" =~ ^[0-9]+$ ]] || { echo "[$n] CLAUDE_RC_ARCHIVE_MINUTES は整数で指定してください: $idle" >&2; return 1; }
  # shellcheck source=/dev/null
  stale="$(. "$CONF_DIR/$n.env"; echo "${CLAUDE_RC_STALE_MINUTES:-10080}")"
  [[ "$stale" =~ ^[0-9]+$ ]] || { echo "[$n] CLAUDE_RC_STALE_MINUTES は整数で指定してください: $stale" >&2; return 1; }
  [ "$(systemctl --user is-active "$(unit "$n")" || true)" = active ] || return 0
  pid="$(tmux -L "claude-rc-$n" display-message -p -t "$n" '#{pane_pid}' 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || { echo "[$n] 警告: サーバーのプロセスを特定できません" >&2; return 0; }
  report_failures "$n" "$pid" "$dry"
  report_auth_failures "$n" "$pid" "$dry"
  python3 - "$n" "$pid" "$idle" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$stale" "$VER_DIR" <<'PY' || rc=$?
import json, os, re, sys, time

name, server, idle_min, cdir = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), sys.argv[4]
stale_min, root = int(sys.argv[5]), sys.argv[6].rstrip("/")


def same_file(a, b):
    # ハードリンクなら inode が一致する。複製（cp -p）のときは大きさと更新時刻で比べる
    return (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino) or (a.st_size, a.st_mtime_ns) == (b.st_size, b.st_mtime_ns)


# サーバーの実行ファイル。固定した版（root/<版>/…）か、版を固定する前のサーバー（置き場所の外）かで判定を分ける
try:
    exe = os.readlink(f"/proc/{server}/exe")
except OSError:
    exe = ""
deleted = exe.endswith(" (deleted)")
path = exe[: -len(" (deleted)")] if deleted else exe
pinned = path.startswith(root + "/")
# 固定した実行ファイルが削除されると、新しいセッションを起動できない（アプリにはオンラインと表示されたままになる）
missing = pinned and deleted
stale = False
if stale_min > 0 and not missing:
    if pinned:
        # 固定した版の元の場所（command -v claude）を開き直し、別のファイルになっていれば本体が更新された
        try:
            ver = path[len(root) + 1:].split("/", 1)[0]
            src = open(os.path.join(root, ver, "source")).read().strip()
            stale = bool(src) and not same_file(os.stat(f"/proc/{server}/exe"), os.stat(src))
        except OSError:
            # 元の場所が開けない（更新の途中）ときは判定しない
            pass
    else:
        # 版を固定する前のサーバーは、削除済みの実行ファイルで動いていれば本体が更新された
        stale = deleted
if idle_min == 0 and not stale and not missing:
    sys.exit(0)
now = time.time()
clk = os.sysconf("SC_CLK_TCK")
btime = next(int(l.split()[1]) for l in open("/proc/stat") if l.startswith("btime"))
UUID = re.compile(r"[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}")

# pid -> (状態, 親pid, 起動時刻)
procs = {}
for d in os.listdir("/proc"):
    if not d.isdigit():
        continue
    try:
        s = open(f"/proc/{d}/stat").read()
        f = s[s.rindex(")") + 2:].split()
        procs[int(d)] = (f[0], int(f[1]), btime + int(f[19]) / clk)
    except (OSError, ValueError):
        pass
kids = {}
for p, (_, pp, _) in procs.items():
    kids.setdefault(pp, []).append(p)


def tree(p):
    out, stack = [p], list(kids.get(p, []))
    while stack:
        q = stack.pop()
        out.append(q)
        stack += kids.get(q, [])
    return out


def cwd_of(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return None


def last_active(pid):
    last, sid = procs[pid][2], "-"
    try:
        argv = open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0")
        for a, b in zip(argv, argv[1:]):
            if a in ("--session-id", "--resume") and UUID.fullmatch(b):
                sid = b
        proj = os.path.join(cdir, "projects", re.sub(r"[^A-Za-z0-9]", "-", cwd_of(pid) or ""))
        own = os.path.join(proj, sid + ".jsonl")
        files = [own] if os.path.isfile(own) else [os.path.join(proj, x) for x in os.listdir(proj) if x.endswith(".jsonl")]
        last = max([os.path.getmtime(x) for x in files], default=last)
    except OSError:
        pass
    return last, sid


def has_reminder(cwd):
    # 読めない・壊れた定義は保持側（リマインダーあり）に倒す
    if not cwd:
        return False
    f = os.path.join(cwd, ".claude", "scheduled_tasks.json")
    if not os.path.exists(f):
        return False
    try:
        return len(json.load(open(f)).get("tasks", [])) > 0
    except (OSError, ValueError, AttributeError):
        return True


if missing:
    print(f"[{name}] 警告: サーバーの実行ファイルが削除されている。新しいセッションを起動できない（{path}）", file=sys.stderr)
sessions = sorted(kids.get(server, []))
if not sessions:
    sys.exit(12 if missing else 11 if stale else 0)
server_cwd = cwd_of(server)
verdicts = set()
for pid in sessions:
    last, sid = last_active(pid)
    idle = int((now - last) // 60)
    if any(procs[q][0] == "R" for q in tree(pid)):
        verdict = "保持(実行中)"
    elif missing:
        verdict = "実行ファイル消失"
    elif has_reminder(cwd_of(pid)) or has_reminder(server_cwd):
        verdict = "保持(リマインダー)"
    elif idle_min > 0 and idle >= idle_min:
        verdict = "アーカイブ"
    elif stale and idle >= stale_min:
        verdict = "本体更新"
    else:
        verdict = "保持(アイドル不足)"
    verdicts.add(verdict)
    print(f"[{name}] セッション={sid} アイドル={idle}分 判定={verdict}")
if missing:
    if verdicts == {"実行ファイル消失"}:
        sys.exit(12)
    print(f"[{name}] 警告: 実行中のセッションがあるため再起動を見送る", file=sys.stderr)
    sys.exit(0)
if verdicts == {"アーカイブ"}:
    sys.exit(10)
if stale and verdicts <= {"アーカイブ", "本体更新"}:
    sys.exit(11)
if stale:
    print(f"[{name}] 警告: claude 本体が更新されているが、利用中のセッションがあるため再起動を見送る", file=sys.stderr)
sys.exit(0)
PY
  if [ "$rc" -eq 10 ]; then
    if [ "$dry" = 1 ]; then
      echo "[$n] 対象: サーバーを再起動してセッションをアーカイブする"
    else
      echo "[$n] アーカイブ: サーバーを再起動する"
      systemctl --user restart "$(unit "$n")"
    fi
    return 0
  fi
  if [ "$rc" -eq 11 ]; then
    if [ "$dry" = 1 ]; then
      echo "[$n] 対象: claude 本体が更新されたためサーバーを再起動する"
    else
      echo "[$n] 本体更新: サーバーを再起動する"
      systemctl --user restart "$(unit "$n")"
    fi
    return 0
  fi
  if [ "$rc" -eq 12 ]; then
    if [ "$dry" = 1 ]; then
      echo "[$n] 対象: 実行ファイルが削除されたためサーバーを再起動する"
    else
      echo "[$n] 実行ファイル消失: サーバーを再起動する"
      systemctl --user restart "$(unit "$n")"
    fi
    return 0
  fi
  return "$rc"
}

# cleanup_versions <dry(0|1)>: どのプロセスも使っていない、固定した版の複製を削除する
# 本体が更新されるたびに版の複製が残る（元が入れ替わると、ハードリンクの複製は旧版の内容を保ち、容量を使う）
# 起動ラッパーは起動のたびに版のディレクトリの更新時刻を新しくするので、10分以内のもの（起動の途中）は残す
cleanup_versions() {
  [ -d "$VER_DIR" ] || return 0
  python3 - "$VER_DIR" "$1" <<'PY'
import os, shutil, sys, time

root, dry = sys.argv[1].rstrip("/"), sys.argv[2] == "1"
used = set()
for d in os.listdir("/proc"):
    if not d.isdigit():
        continue
    try:
        exe = os.readlink(f"/proc/{d}/exe")
    except OSError:
        continue
    if exe.endswith(" (deleted)"):
        exe = exe[: -len(" (deleted)")]
    if exe.startswith(root + "/"):
        used.add(exe[len(root) + 1:].split("/", 1)[0])
now = time.time()
for v in sorted(os.listdir(root)):
    p = os.path.join(root, v)
    try:
        if v in used or now - os.lstat(p).st_mtime < 600:
            continue
        if dry:
            print(f"[版] 対象: 使われていない版 {v} を削除する")
            continue
        if os.path.isdir(p) and not os.path.islink(p):
            shutil.rmtree(p)
        else:
            os.remove(p)
        print(f"[版] 削除: {v}")
    except OSError as e:
        print(f"[版] 警告: 版 {v} を削除できません: {e}", file=sys.stderr)
PY
}

cmd="${1:-}"; shift || true
case "$cmd" in
  add)
    spawn=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --spawn) [ $# -ge 2 ] || { usage; exit 1; }; spawn="$2"; shift 2 ;;
        --spawn=*) spawn="${1#--spawn=}"; shift ;;
        *) break ;;
      esac
    done
    [ $# -ge 1 ] || { usage; exit 1; }
    [ -z "$spawn" ] || [[ "$spawn" =~ ^(same-dir|worktree)$ ]] || { echo "--spawn は same-dir か worktree を指定してください: $spawn" >&2; exit 1; }
    dir="$(realpath "$1")"
    [ -d "$dir" ] || { echo "ディレクトリがありません: $dir" >&2; exit 1; }
    name="${2:-$(basename "$dir")}"
    [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "name は英数字と _ . - のみ使えます: $name" >&2; exit 1; }
    [ -f "$CONF_DIR/$name.env" ] && { echo "既に登録済みです: $name" >&2; exit 1; }
    if [ "$spawn" = worktree ]; then
      git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || echo "警告: git リポジトリではないため worktree モードは使えません（--spawn same-dir を指定してください）" >&2
    fi
    mkdir -p "$CONF_DIR"
    printf 'CLAUDE_RC_DIR=%q\n' "$dir" > "$CONF_DIR/$name.env"
    [ -z "$spawn" ] || printf 'CLAUDE_RC_SPAWN=%q\n' "$spawn" >> "$CONF_DIR/$name.env"
    systemctl --user daemon-reload
    systemctl --user enable --now "$(unit "$name")"
    echo "登録しました: $name -> $dir"
    is_trusted "$dir" || echo "注意: このディレクトリは未信頼です。'claude-rc-ctl attach $name' で信頼確認に応答してください" >&2
    ;;
  remove)
    need_name "$@"
    systemctl --user disable --now "$(unit "$1")" || true
    rm -f "$CONF_DIR/$1.env" "$STATE_DIR/$1.failed" "$STATE_DIR/$1.authfail"
    echo "登録解除しました: $1"
    ;;
  list)
    shopt -s nullglob
    printf '%-20s %-10s %s\n' NAME STATE DIR
    for f in "$CONF_DIR"/*.env; do
      n="$(basename "$f" .env)"
      # shellcheck source=/dev/null
      d="$(. "$f"; echo "$CLAUDE_RC_DIR")"
      printf '%-20s %-10s %s\n' "$n" "$(systemctl --user is-active "$(unit "$n")" || true)" "$d"
    done
    ;;
  start|stop|restart|status)
    need_name "$@"
    systemctl --user "$cmd" "$(unit "$1")"
    ;;
  archive)
    dry=0
    if [ "${1:-}" = "--dry-run" ]; then dry=1; shift; fi
    [ $# -eq 1 ] || { usage; exit 1; }
    if [ "$1" = "--all" ]; then
      shopt -s nullglob
      rc=0
      for f in "$CONF_DIR"/*.env; do
        archive_one "$(basename "$f" .env)" "$dry" || rc=1
      done
      cleanup_versions "$dry" || rc=1
      exit "$rc"
    fi
    need_name "$@"
    archive_one "$1" "$dry"
    ;;
  attach)
    need_name "$@"
    exec tmux -L "claude-rc-$1" attach -t "$1"
    ;;
  logs)
    need_name "$@"
    echo "=== 画面出力 ==="
    tmux -L "claude-rc-$1" capture-pane -p -t "$1" 2>/dev/null || echo "(起動していません)"
    echo "=== journal ==="
    journalctl --user -u "$(unit "$1")" -n 30 --no-pager
    ;;
  self)
    case "${1:-}" in
      update|uninstall|status|refs) ;;
      *) usage; exit 1 ;;
    esac
    installer="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../installer/main.sh"
    [ -f "$installer" ] || { echo "インストーラがありません（install.sh 経由で導入してください）: $installer" >&2; exit 1; }
    exec sh "$installer" "$@"
    ;;
  ""|-h|--help|help) usage ;;
  *) echo "不明なコマンド: $cmd" >&2; usage; exit 1 ;;
esac
